# 本地 HTTP 服务端口（代理 + 网页聊天）
PORT=3265

# agent 工具（终端 / 文件）的工作目录 —— 沙箱
QWEN_WORKSPACE=~/qwen-workspace

# chat.qwen.ai 网页客户端的版本号，作为请求头 `version` 发出去。
# 🔴 铁律：别改成线上真实版本号。实测线上是 0.3.16，但带 0.3.16 会被判
# Unauthorized，带 0.2.83 才放行。
# 真遇到 WAF 报错时：DevTools -> Network -> 任意 chat.qwen.ai 请求 ->
# Request Headers -> version，看当前值再试。
QWEN_WEB_VERSION=0.2.83

# 默认模型（客户端没传 model 时用这个）
DEFAULT_MODEL=qwen3.8-max

# 入口 JSON 请求体大小上限。这是技术限制，不是模型 token 限制。
MAX_PAYLOAD_BYTES=16777216

# SSE 流多久没新数据就算超时（毫秒）
STREAM_IDLE_TIMEOUT_MS=180000

# 日志级别：debug|info|warn|error
LOG_LEVEL=info

# 登录脚本用哪个浏览器内核。设成 chrome 就用本机 Chrome（Windows 推荐，
# 项目不带 Chromium 内核时不设这个会报找不到浏览器）。
# PLAYWRIGHT_CHANNEL=chrome
